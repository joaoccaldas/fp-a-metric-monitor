# FP&A Metric Monitor Configuration Template
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Webhook Configuration (optional)
# URL to send notifications (e.g., Slack webhook, Discord webhook, or custom endpoint)
WEBHOOK_URL=https://hooks.example.com/your-webhook-url

# Data Source Configuration (for future enhancements)
# DATABASE_URL=postgresql://user:password@localhost:5432/fpa_metrics
# API_ENDPOINT=https://api.example.com/v1/metrics
# API_KEY=your_data_source_api_key

# Monitoring Configuration
# SCHEDULE_INTERVAL=3600  # Run every hour (in seconds)
# ALERT_THRESHOLD_MARGIN=0.25  # Alert if margin drops below 25%
# ALERT_THRESHOLD_BURN=150000  # Alert if burn rate exceeds $150k
